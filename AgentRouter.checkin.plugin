#!name=AgentRouter 自动签到
#!desc=v1.4.1 · agentrouter.org 每日自动签到：用账号密码完成一次登录即签到，并回查个人日志确认「签到成功」。安装后请在下方填入账号（单账号填 邮箱和密码 两项，用英文井号隔开；多账号填 多账号 JSON 数组）。默认每天 09:00 运行一次（站点本身按天去重，一天一次就够，也最不容易触发风控）；若想一天多次，把任务 cron 改成每小时并在「签到时间点」填如 9,15,21。若提示需要人机验证，把「指定节点或策略组」填 DIRECT 直连即可。另外每周一会自动检查上游 Python 脚本是否有未移植的新提交并提醒。
#!author=cth123456
#!homepage=https://github.com/cth123456/loon-scripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
#!input = 单账号[邮箱和密码]
#!input = 多账号[JSON数组]
#!input = 签到时间点[可留空]
#!input = 指定节点或策略组[可留空]
#!input = 站点域名[可留空]

[Script]
cron "0 9 * * *" script-path=https://raw.githubusercontent.com/cth123456/loon-scripts/main/agentrouter-checkin.js, tag=AgentRouter签到, enable=true, timeout=120
cron "0 10 * * 1" script-path=https://raw.githubusercontent.com/cth123456/loon-scripts/main/upstream-watch.js, tag=AgentRouter上游检查, enable=true, timeout=60
