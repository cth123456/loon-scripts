#!name=AgentRouter 自动签到（jsDelivr 镜像版）
#!desc=v1.5.1 · 单账号只需填写邮箱和密码，兼容旧持久化账号；多账号可填 JSON 数组。每天3、5、10点签到，手动点击签到 cron 直接执行，不受旧小时配置影响。每账号每轮最多10次登录，成功立即停止，明确凭据错误、人机验证和限流不重试；预算可能提前结束。验证码仍未解决，不绕过验证。每周一检查上游更新。
#!author=cth123456
#!homepage=https://github.com/cth123456/loon-scripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
#!input = 单账号[邮箱]
#!input = 单账号[密码]
#!input = 多账号[JSON数组]
#!input = 指定节点或策略组[可留空]
#!input = 站点域名[可留空]

[Script]
cron "0 3,5,10 * * *" script-path=https://cdn.jsdelivr.net/gh/cth123456/loon-scripts@main/agentrouter-checkin.js, tag=AgentRouter签到, enable=true, timeout=120
cron "0 10 * * 1" script-path=https://cdn.jsdelivr.net/gh/cth123456/loon-scripts@main/upstream-watch.js, tag=AgentRouter上游检查, enable=true, timeout=60
