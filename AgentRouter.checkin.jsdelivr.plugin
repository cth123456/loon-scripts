#!name=AgentRouter 自动签到（jsDelivr 镜像版）
#!desc=v1.5.2 · 单账号只需填写邮箱和密码，兼容旧持久化账号；多账号可填 JSON 数组。每天3、5、10点自动签到，点击运行按钮立即执行。每账号每轮最多尝试10次登录，每次重试前刷新会话、间隔8秒，成功立即停止；仅服务器明确返回密码错误时不重试（确定性失败，避免锁号）。人机验证无法绕过，重试目的是等风控放松。每周一检查上游更新。
#!author=cth123456
#!homepage=https://github.com/cth123456/loon-scripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
#!input = 单账号[邮箱]
#!input = 单账号[密码]
#!input = 多账号[JSON数组]
#!input = 指定节点或策略组[可留空]
#!input = 站点域名[可留空]

[Script]
cron "0 3,5,10 * * *" script-path=https://cdn.jsdelivr.net/gh/cth123456/loon-scripts@main/agentrouter-checkin.js, tag=AgentRouter签到, enable=true, timeout=300
cron "0 10 * * 1" script-path=https://cdn.jsdelivr.net/gh/cth123456/loon-scripts@main/upstream-watch.js, tag=AgentRouter上游检查, enable=true, timeout=60
