#!name=EOOS 每日签到
#!desc=EOOS 站点每日自动签到。需要填写网页登录后的 auth_token（只保存在 Loon 本地）。签到时自动完成 Cap 工作量证明验证。
#!author=cth123456
#!homepage=https://github.com/cth123456/loon-scripts
#!input=EOOS_TOKEN

[Script]
cron "7 8 * * *" script-path=https://raw.githubusercontent.com/cth123456/loon-scripts/main/eoos-checkin.js,tag="EOOS 签到",enable=true,timeout=120
