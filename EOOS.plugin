#!name=EOOS 每日签到
#!desc=v1.3.0 · 自动登录拿令牌并缓存，令牌失效会自动重新登录，无需手动抓 token。定时任务每小时唤起，只在「签到时间点」匹配时签到，留空则每小时执行。需要立即签到请运行「EOOS手动签到」，不受时间点限制。请求默认 DIRECT，可填写节点或策略组；TLS 失败时先退回 DIRECT 并诊断；确认是 Loon 根证书问题后可填「允许跳过证书校验[留空=否]」为 是。签到时自动完成 Cap 工作量证明验证。
#!author=cth123456
#!homepage=https://github.com/cth123456/loon-scripts
#!icon=https://raw.githubusercontent.com/Koolson/Qure/master/IconSet/Color/Proxy.png
#!input = 单账号[用户名或邮箱]
#!input = 单账号[密码]
#!input = 签到时间点[可留空]
#!input = 指定节点或策略组[可留空]
#!input = 允许跳过证书校验[留空=否]

[Script]
cron "0 * * * *" script-path=https://raw.githubusercontent.com/cth123456/loon-scripts/main/eoos-checkin.js,tag="EOOS 签到",enable=true,timeout=120,argument="scheduled"
generic script-path=https://raw.githubusercontent.com/cth123456/loon-scripts/main/eoos-checkin.js,tag="EOOS 手动签到",timeout=120,argument="manual"
